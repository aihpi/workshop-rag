# Copy this file to `.env` and insert your own credentials.
#   cp .env.example .env
# `.env` is gitignored. Never commit it, and never put your key in a notebook.

# HPI AISC API (required by all notebooks)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.aisc.hpi.de/

# Qdrant (defaults match a local Docker container)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# OCR / VLM comparison (w2_04, optional). The notebook has working defaults;
# uncomment a line only to override it. An empty value would override the
# default with an empty string.
DOCLING_VLM_PRESET=granite_docling
# DOCLING_API_VLM_URL=https://api.aisc.hpi.de/v1/chat/completions
# DOCLING_API_VLM_MODEL=qwen3-vl-32b
# EXTERNAL_VLM_MODEL=openai/qwen3-vl-32b
